{
  "cli": {
    "packageManager": "npm"
  },
  "generators": {
    "@nx/angular:application": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "vitest-analog",
      "e2eTestRunner": "cypress"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest-analog"
    },
    "@nx/angular:component": {
      "style": "scss"
    }
  },
  "defaultProject": "seo-demo",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "e2e": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "@analogjs/vitest-angular:test": {
      "inputs": ["default", "^production"],
      "cache": true,
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "coverage": true
        }
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/vitest.config.[jt]s",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/src/test-setup.[jt]s"
    ]
  },
  "defaultBase": "master",
  "affected": {
    "legacy": true
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/seo-demo/**/*",
        "apps/seo-demo-e2e/**/*",
        "libs/mintplayer-ng-base-url/**/*",
        "libs/mintplayer-ng-router/**/*",
        "libs/mintplayer-ng-router-provider/**/*",
        "libs/mintplayer-ng-seo/**/*",
        "libs/mintplayer-ng-share-buttons/**/*",
        "libs/mintplayer-script-loader/**/*"
      ]
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "run",
        "testTargetName": "test"
      },
      "include": ["tools/**/*"]
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci"
      }
    }
  ]
}
